# Where the API lives. Server components call it directly; the browser uses the same URL.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# The public canonical origin, used for canonical URLs, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Hostname serving product images, so next/image is allowed to optimise them.
NEXT_PUBLIC_MEDIA_HOST=
# Publishable key only. The secret key belongs in the backend and nowhere else.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: a number with the country code, e.g. 919876543210. Blank hides the button.
NEXT_PUBLIC_WHATSAPP_NUMBER=
